{
  "realm": "quarkus",
  "enabled": true,
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "alice"
        }
      ],
      "realmRoles": ["user"]
    },
    {
      "username": "bob",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "bob"
        }
      ],
      "realmRoles": ["user"]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "user"
      }
    ]
  },
  "clients": [
    {
      "clientId": "backend-service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "my-secret-value",
      "redirectUris": ["*"],
      "serviceAccountsEnabled": true
    }
  ]
}